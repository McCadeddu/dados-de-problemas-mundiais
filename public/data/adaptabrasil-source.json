ax_number_of_records":63,"order":2},{"id":"mesorregiao","name":"Mesorregião","label":"15 Mesorregiões","recordcount":15,"max_number_of_records":15,"order":3}]},{"id":"SE","clipping":"Sergipe","order":26,"resolutions":[{"id":"municipio","name":"Município","label":"75 Municípios","recordcount":75,"max_number_of_records":75,"order":1},{"id":"microrregiao","name":"Microrregião","label":"13 Microrregiões","recordcount":13,"max_number_of_records":13,"order":2},{"id":"mesorregiao","name":"Mesorregião","label":"3 Mesorregiões","recordcount":3,"max_number_of_records":3,"order":3}]},{"id":"TO","clipping":"Tocantins","order":27,"resolutions":[{"id":"municipio","name":"Município","label":"139 Municípios","recordcount":139,"max_number_of_records":139,"order":1},{"id":"microrregiao","name":"Microrregião","label":"8 Microrregiões","recordcount":8,"max_number_of_records":8,"order":2},{"id":"mesorregiao","name":"Mesorregião","label":"2 Mesorregiões","recordcount":2,"max_number_of_records":2,"order":3}]}]},{"id":"semiarido","category":"Região Estratégica","order":4,"clippings":[{"id":"SA","clipping":"Semiárido","order":1,"resolutions":[{"id":"municipio","name":"Município","label":"1427 Municípios","recordcount":1427,"max_number_of_records":676,"order":1}]}]}]}},{"id":2,"name":"Risco de estresse hídrico","title":"Índice de risco de impacto do estresse hídrico ","shortname":"Risco de estresse hídrico","simple_description":"Risco de impacto das mudanças climáticas no balanço hídrico dos sistemas socioecológicos, considerando a ameaça de escassez hídrica.","complete_description":"Risco de impacto das mudanças climáticas no balanço hídrico dos sistemas socioecológicos em função do estresse hídrico, resultante da interação entre as três dimensões (Ameaça, Vulnerabilidade e Exposição), considerando a Ameaça como o saldo de vazão nas bacias hidrográficas (disponibilidade hídrica), oriundo da modelagem hidrológica com cenários climáticos projetados relacionados ao deficit hídrico (interação das características biofísicas, precipitação e evapotranspiração potencial); Vulnerabilidade como as características do sistema socioecológico propensas a sofrer dano; e Exposição como os elementos diretamente impactados (usuários dos recursos hídricos). Considera-se estresse hídrico como alterações no regime de vazões em bacias hidrográficas em função do deficit hídrico provocado pela diminuição abrupta ou prolongada de precipitação por um período — uma estação, um ano ou vários anos — em comparação com a média multianual estatística para uma região que resulta em escassez de água para alguma atividade, grupo ou setor ambiental. A escassez hídrica resulta em perdas econômicas e sociais significativas para diversos setores, desde a agricultura, abastecimento humano, indústrias, energia ao turismo, provocando efeitos profundos nas comunidades locais. Deficits mais frequentes implicarão em aumento de custos para a sociedade, necessitando de estratégias de adaptação por parte dos usuários de água. <br><br>Fonte:<br>AGÊNCIA NACIONAL DE ÁGUAS E SANEAMENTO BÁSICO. Impacto da Mudança Climática nos Recursos Hídricos do Brasil: Brasília, Brasil, 2024. <br>FOOD AND AGRICULTURE ORGANIZATION/NATIONAL DROUGHT MITIGATION CENTER - FAO/NDMC. The Near East Drought Planning Manual. Food and Agriculture Organization of the United Nations (FAO): Rome: Italy, 2008. <br><br>Fonte:<br>Sistema de Informações e Análises sobre Impactos das Mudanças Climáticas - AdaptaBrasil MCTI.","equation":null,"level":2,"pessimist":1,"indicator_id_master":"1","years":[2020,2030,2050],"years_description":null,"scenarios":null,"imageurl":null,"sep_id":1,"sep_description":null,"disturbance":null,"geometrytype":"MultiPolygon","measurement_unit":null,"climate_hazard":null,"legend":{"items":[{"order":1,"label":"Muito baixo","color":"#02C650","valuerange":"0,00 a 0,19","minvalue":0,"maxvalue":0.19},{"order":2,"label":"Baixo","color":"#A9DE00","valuerange":"0,20 a 0,39","minvalue":0.2,"maxvalue":0.39},{"order":3,"